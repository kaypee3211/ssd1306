  Serial.begin(115200);
  Serial.println("Hello, ESP32!");

  



  Wire1.begin(22, 21);
  Wire.begin(17, 16);

  oled1.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  oled2.begin(SSD1306_SWITCHCAPVCC, 0x3C);  

  oled1.clearDisplay();

  oled1.drawBitmap(0, 0, epd_bitmap_jonathan, 128, 64, WHITE);
  oled1.display();

  oled2.clearDisplay();
  oled2.drawBitmap(0, 0, epd_bitmap_leone_abbacchio, 128, 64, WHITE);
  oled2.display();
  //epd_bitmap_jonathan
  //epd_bitmap_leone_abbacchio

}

void loop() {
  // put your main code here, to run repeatedly:
  delay(10); // this speeds up the simulation
}
